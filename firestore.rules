rules_version = '2';

// RoommateFinder Firestore rules.
//
// This app talks to Firestore directly from the browser — the Firebase web API
// key in client/.env is public by design and is NOT a secret. These rules are
// the only thing standing between a listing and anyone with a browser console,
// so every collection below is deny-by-default and opens up only what a
// specific screen actually needs.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Gates the creation of public content. Applied to `create` only, never to
    // `update` or `delete`: members who signed up before verification existed
    // must still be able to edit and take down what they already posted.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- users ---------------------------------------------------------
    //
    // A user document holds the phone number shown behind the "Call" button,
    // so it is readable by signed-in users only — and never listable, or the
    // whole user base could be scraped for phone numbers in one query.

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;

      // Signup writes the email; later screens (Preferences, saved listings,
      // Profile) use setDoc/merge and may legitimately create the document
      // without one, so email is only checked when it is actually present.
      allow create: if isSelf(userId)
                    && (!('email' in request.resource.data)
                        || request.resource.data.email == request.auth.token.email)
                    && !('isAdmin' in request.resource.data);

      // `isAdmin` is granted only from the Firebase console / Admin SDK.
      // Without this clause any user could grant themselves the moderation
      // queue by writing { isAdmin: true } to their own document.
      allow update: if isSelf(userId)
                    && !changedKeys().hasAny(['isAdmin', 'email', 'createdAt']);

      allow delete: if false;
    }

    // ---- properties (room listings) ------------------------------------
    //
    // Public read: browsing listings must work logged out. Contact details
    // are not stored here — they live on the owner's user document, which
    // requires sign-in.

    match /properties/{propertyId} {
      allow read: if true;

      allow create: if isVerified()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 5000
                    && request.resource.data.rent is number
                    && request.resource.data.rent >= 0
                    && request.resource.data.rent <= 10000000;

      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.rent is number
                    && request.resource.data.rent >= 0;

      allow delete: if isSignedIn()
                    && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ---- seekers (roommate profiles) -----------------------------------
    //
    // Document ID is the owner's uid, so ownership needs no lookup.
    // Publicly readable, so it must never carry email or phone number.

    match /seekers/{seekerId} {

      // Current profiles use the owner's uid as the document ID, but older ones
      // were created with addDoc and carry a random ID. Ownership therefore has
      // to be read from the userId field, not from the document ID — keying off
      // the ID alone would lock those earlier members out of their own profile.
      function ownsExisting() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow read: if true;

      allow create: if isSelf(seekerId)
                    && isVerified()
                    && request.resource.data.userId == request.auth.uid
                    && !('email' in request.resource.data)
                    && !('contactNumber' in request.resource.data)
                    && request.resource.data.bio is string
                    && request.resource.data.bio.size() <= 5000;

      allow update: if ownsExisting()
                    && request.resource.data.userId == request.auth.uid
                    && !('email' in request.resource.data)
                    && !('contactNumber' in request.resource.data)
                    && request.resource.data.bio is string
                    && request.resource.data.bio.size() <= 5000;

      allow delete: if ownsExisting() || isAdmin();
    }

    // ---- chats ---------------------------------------------------------

    match /chats/{chatId} {

      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      // `list` is evaluated per candidate document, so ChatList's
      // where('participants', 'array-contains', uid) query passes and a
      // query for anyone else's threads is rejected.
      allow get, list: if isParticipant();

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      // Participants may update metadata but never rewrite who is in the chat.
      allow update: if isParticipant()
                    && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {

        function inParentChat() {
          return isSignedIn()
            && request.auth.uid in
               get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow read: if inParentChat();

        allow create: if inParentChat()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;

        // Messages are immutable — no silent edits to a conversation history.
        allow update, delete: if false;
      }
    }

    // ---- notifications -------------------------------------------------
    //
    // Written by the *actor* (the person who saved a listing or sent a
    // message) into the *recipient's* feed, so create is checked against
    // actorId rather than userId.

    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.userId != request.auth.uid
                    && request.resource.data.read == false
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 200;

      allow update: if isSignedIn() && (
                      // Recipient marks it read — and may change nothing else.
                      (resource.data.userId == request.auth.uid
                       && changedKeys().hasOnly(['read']))
                      // Or the same actor re-fires the event, refreshing it.
                      || (resource.data.actorId == request.auth.uid
                          && request.resource.data.actorId == request.auth.uid
                          && request.resource.data.userId == resource.data.userId)
                    );

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- reports (moderation) ------------------------------------------
    //
    // Reports are write-only for regular users: you can file one, but you
    // cannot read the queue or see what anyone else reported.

    match /reports/{reportId} {
      allow get, list: if isAdmin();

      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.details is string
                    && request.resource.data.details.size() <= 1000;

      allow update: if isAdmin()
                    // A reporter may overwrite their own still-open report
                    // (ReportButton uses setDoc with a deterministic ID).
                    || (isSignedIn()
                        && resource.data.reporterId == request.auth.uid
                        && request.resource.data.reporterId == request.auth.uid
                        && request.resource.data.status == 'open');

      allow delete: if false;
    }

    // ---- default deny ---------------------------------------------------
    // Any collection not named above is unreachable. Adding a new feature
    // means adding a block here first.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
