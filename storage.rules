rules_version = '2';

// RoommateFinder Cloud Storage rules.
//
// Only profile pictures go through Firebase Storage — listing photos are
// uploaded to Cloudinary (see client/src/utils/cloudinary.js). Everything
// outside profile-pics/ is closed.

service firebase.storage {
  match /b/{bucket}/o {

    // profile-pics/{uid} — one image per user, overwritten in place.
    // Size and content type are enforced here as well as in the client, since
    // the client check is only a courtesy.
    match /profile-pics/{userId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
