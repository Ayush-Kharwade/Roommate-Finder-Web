# Copy to server/.env and fill in. Never commit the real .env.
#
# These ARE secrets — unlike the client's VITE_ values, nothing here reaches
# the browser. Do not paste connection strings into comments.

# MongoDB Atlas connection string.
MONGO_URI=

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=https://localhost:5173

NODE_ENV=development
PORT=5000
